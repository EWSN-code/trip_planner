:root{--bg:#f3f4f6;--card:#fff;--text:#111827;--muted:#6b7280;--accent:#7a0019;--line:#e5e7eb}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,a,input,select,textarea{font:inherit}button{border:0;border-radius:999px;padding:9px 13px;background:var(--accent);color:#fff;font-weight:700;cursor:pointer}.sub{background:#fff;color:var(--text);border:1px solid var(--line)}.danger{background:#fff;color:#b91c1c;border:1px solid #fecaca}.text{background:transparent;color:var(--accent);padding:0}.small{font-size:12px;padding:6px 9px}.icon{width:34px;height:34px;padding:0;background:#f3f4f6;color:#111}header{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;gap:12px;align-items:center;padding:13px 16px;background:#fffffff2;border-bottom:1px solid var(--line)}header h1,header small{margin:0}.actions{display:flex;gap:7px;flex-wrap:wrap}nav{display:flex;gap:7px;padding:9px 16px;background:#fff;border-bottom:1px solid var(--line)}nav button,nav a{background:#fff;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:7px 11px;text-decoration:none;font-size:13px;font-weight:700}nav .active{background:#fef2f2;color:var(--accent)}.disabled{pointer-events:none;opacity:.45}main{max-width:980px;margin:auto;padding:17px 15px 60px}.muted{color:var(--muted);font-size:13px}.trip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}.card,.timeline-item,.budget-grid section,.top-summary>div{background:#fff;border:1px solid var(--line);border-radius:15px;padding:13px}.card h3{margin:0 0 5px}.card-actions,.item-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.detail-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.detail-head h2{margin:5px 0}.top-summary{display:grid;grid-template-columns:2fr 1fr 1fr;gap:9px;margin:12px 0}.top-summary span{display:block;color:var(--muted);font-size:11px}.top-summary strong{font-size:19px}.budget-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:12px}.budget-grid h3{margin:0 0 6px;font-size:14px}.sum-row{display:flex;justify-content:space-between;border-bottom:1px dashed var(--line);padding:4px 0;font-size:13px}.tabs{display:flex;gap:7px;overflow:auto;margin-bottom:10px}.tab{white-space:nowrap;background:#fff;color:var(--muted);border:1px solid var(--line)}.tab.active{background:var(--accent);color:#fff}.timeline{display:grid;gap:9px}.row{display:grid;grid-template-columns:68px 1fr;gap:9px}.time{font-weight:800}.station-line,.title-line{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.station-name,.item-title{font-size:16px;font-weight:800}.pill{display:inline-flex;padding:2px 7px;border-radius:999px;background:#eef2ff;font-size:10px;font-weight:700}.point{background:#dbeafe}.cost{background:#fef3c7;color:#92400e}.reservation{background:#fff7ed;color:#9a3412}.transport{margin-left:78px;border-left:6px solid var(--accent);padding-left:11px}.transport strong{font-size:15px}.meta,.notes{margin-top:4px;color:#4b5563;font-size:12px;line-height:1.45}.resources{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.resources a{padding:4px 8px;border-radius:999px;background:#eff6ff;color:#1d4ed8;text-decoration:none;font-size:10px;font-weight:700}.item-actions{justify-content:flex-end}dialog{border:0;border-radius:18px;padding:0;width:min(650px,calc(100vw - 22px));box-shadow:0 20px 60px #0005}dialog::backdrop{background:#11182766}form{padding:17px;display:grid;gap:11px;max-height:88vh;overflow:auto}.dialog-head,.dialog-actions{display:flex;justify-content:space-between;align-items:center;gap:8px}.dialog-head h2{margin:0}.dialog-actions{justify-content:flex-end}label{display:grid;gap:4px;font-size:12px;font-weight:700}.check{display:flex;align-items:center}.check input{width:auto}input,select,textarea{width:100%;padding:9px;border:1px solid #d1d5db;border-radius:9px;background:#fff}.cols,.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.expense-row{display:grid;grid-template-columns:1.5fr 1fr 60px 1fr 1fr auto;gap:5px;margin:7px 0}.expense-row button{padding:6px}.toast{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:#111827;color:#fff;border-radius:999px;padding:9px 14px}@media(max-width:650px){header{align-items:flex-start;flex-direction:column}.top-summary{grid-template-columns:1fr 1fr}.top-summary>div:first-child{grid-column:1/-1}.budget-grid,.cols,.field-grid{grid-template-columns:1fr}.transport{margin-left:0}.row{grid-template-columns:55px 1fr}.expense-row{grid-template-columns:1fr 80px 55px}.expense-row select{grid-column:auto}.detail-head{align-items:flex-start;flex-direction:column}}

.cloud-status{display:flex;gap:7px;align-items:center;flex-wrap:wrap;font-size:11px;color:var(--muted)}#syncStatus{display:inline-flex;padding:4px 8px;border-radius:999px;background:#f3f4f6;font-weight:700}#syncStatus.syncing{background:#fff7ed;color:#9a3412}#syncStatus.synced{background:#ecfdf5;color:#047857}#syncStatus.error{background:#fef2f2;color:#b91c1c}.auth-dialog{width:min(430px,calc(100vw - 22px))}.auth-dialog form{max-height:none}
